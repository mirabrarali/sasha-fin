# Gemini API Configuration
# Set either GEMINI_API_KEY or GOOGLE_GENAI_API_KEY
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=

# Optional: long LLM timeout in ms (default 120000). Used for chat, financial upload analysis, and data dashboards.
# LLM_CHAT_TIMEOUT_MS=180000

# Optional: Vercel KV for Knowledge Base (if using serverless)
# KV_URL=your_vercel_kv_url
# KV_REST_API_URL=your_vercel_kv_rest_api_url
# KV_REST_API_TOKEN=your_vercel_kv_rest_api_token
