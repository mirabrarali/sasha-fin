# Gemini API Configuration
# Set either GEMINI_API_KEY or GOOGLE_GENAI_API_KEY
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=

# Optional: long LLM timeout in ms (default 120000). Used for chat, financial upload analysis, and data dashboards.
# LLM_CHAT_TIMEOUT_MS=180000

# Optional: max milliseconds to sleep between Gemini retries on 429/503 (default 120000). Lower on tight serverless budgets.
# GEMINI_RETRY_MAX_SLEEP_MS=45000

# Spreadsheet workspace (Groq-powered, independent from chat/data-analytics Gemini stack)
GROQ_SPREADSHEET_API_KEY=
# GROQ_SPREADSHEET_CONVO_MODEL=llama-3.1-8b-instant
# Primary model for spreadsheet analysis / report / chart (defaults to 8B if unset — large models hit free-tier TPD quickly).
# GROQ_SPREADSHEET_ANALYTICS_MODEL=llama-3.1-8b-instant
# Optional: if the primary analytics model returns 429, one retry uses this model (defaults to CONVO model or 8B).
# GROQ_SPREADSHEET_ANALYTICS_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: Vercel KV for Knowledge Base (if using serverless)
# KV_URL=your_vercel_kv_url
# KV_REST_API_URL=your_vercel_kv_rest_api_url
# KV_REST_API_TOKEN=your_vercel_kv_rest_api_token
